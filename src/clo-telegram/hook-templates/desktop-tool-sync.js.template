#!/usr/bin/env node
"use strict";

// PostToolUse hook: 도구 실행 후 텔레그램 알림 메시지를 업데이트
// approval-bridge.js가 저장한 desktop-pending.json을 읽어
// 텔레그램 메시지를 "✅ 승인됨" 또는 "⏩ 처리됨"으로 갱신

const fs = require("node:fs");
const path = require("node:path");

const BRIDGE_DIR = path.join("__INSTALL_DIR__", "data", "bridge");
const PENDING_FILE = path.join(BRIDGE_DIR, "desktop-pending.json");

function loadEnv() {
  const envPath = path.join("__INSTALL_DIR__", ".env");
  if (!fs.existsSync(envPath)) return {};
  const lines = fs.readFileSync(envPath, "utf-8").split("\n");
  const env = {};
  for (const line of lines) {
    const match = line.match(/^([A-Z_]+)=(.+)$/);
    if (match) env[match[1]] = match[2].trim();
  }
  return env;
}

let input = "";
process.stdin.on("data", (chunk) => { input += chunk; });
process.stdin.on("end", async () => {
  try {
    if (!fs.existsSync(PENDING_FILE)) {
      process.exit(0);
      return;
    }

    const pending = JSON.parse(fs.readFileSync(PENDING_FILE, "utf-8"));
    const data = JSON.parse(input);
    const age = Date.now() - pending.requestedAt;

    const isMatch = data.tool_name === pending.toolName;
    const isStale = age > 30000;

    if (!isMatch && !isStale) {
      process.exit(0);
      return;
    }

    const env = loadEnv();
    const token = env.TELEGRAM_BOT_TOKEN;
    if (!token) {
      try { fs.unlinkSync(PENDING_FILE); } catch {}
      process.exit(0);
      return;
    }

    const newText = isMatch ? `✅ ${pending.toolName}` : `⏩ ${pending.toolName}`;

    await fetch(`https://api.telegram.org/bot${token}/editMessageText`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        chat_id: pending.chatId,
        message_id: pending.messageId,
        text: newText,
      }),
      signal: AbortSignal.timeout(3000),
    }).catch(() => {});

    try { fs.unlinkSync(PENDING_FILE); } catch {}

  } catch {
    try { fs.unlinkSync(PENDING_FILE); } catch {}
  }
  process.exit(0);
});
